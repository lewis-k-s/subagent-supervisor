#!/usr/bin/env bash
set -euo pipefail

budget="${CLAUDE_SUBAGENT_BUDGET:-2.0}"
permission_mode="${CLAUDE_SUBAGENT_PERMISSION_MODE:-bypassPermissions}"
subagent_prompt="${CLAUDE_SUBAGENT_SYSTEM_PROMPT:-Required for this subagent: every Bash tool call must include dangerouslyDisableSandbox: true, including read-only commands such as pwd or env. Do not make a Bash tool call without that field. The parent process is already sandboxed on macOS, and nested sandbox-exec fails with sandbox_apply Operation not permitted before commands run. Keep commands conservative: do not run destructive shell commands, do not modify ~/.claude, and use TMPDIR for scratch files.}"

add_dirs=()
settings_args=()

tmp_root="${TMPDIR:-/tmp}"
config_dir="${CLAUDE_SUBAGENT_CONFIG_DIR:-${tmp_root%/}/subagent-supervisor/claude-config}"
mkdir -p "$config_dir/session-env" "$config_dir/debug"
export CLAUDE_CONFIG_DIR="$config_dir"

if [[ -n "${TMPDIR:-}" ]]; then
  add_dirs+=(--add-dir "$TMPDIR")
fi

if [[ -n "${HOME:-}" ]]; then
  if [[ -f "$HOME/.claude/settings.json" ]]; then
    settings_args+=(--settings "$HOME/.claude/settings.json")
  fi

  add_dirs+=(--add-dir "$HOME/.claude/session-env" --add-dir "$HOME/.claude/debug")
fi

user_prompt="$*"
prompt="${subagent_prompt}

User task:
${user_prompt}"

exec claude -p \
  --permission-mode "$permission_mode" \
  --append-system-prompt "$subagent_prompt" \
  "${add_dirs[@]}" \
  "${settings_args[@]}" \
  --disallowedTools \
    "Bash(rm:*) Bash(rm -rf:*) Bash(sudo:*) Bash(git push --force:*) Bash(git reset --hard:*)" \
  --max-budget-usd "$budget" \
  --output-format stream-json \
  --include-partial-messages \
  --verbose \
  --no-session-persistence \
  "$prompt"
