#!/usr/bin/env bash
set -euo pipefail

budget="${CLAUDE_SUBAGENT_BUDGET:-2.0}"
permission_mode="${CLAUDE_SUBAGENT_PERMISSION_MODE:-auto}"
subagent_prompt="${CLAUDE_SUBAGENT_SYSTEM_PROMPT:-Keep commands conservative: do not run destructive shell commands, do not modify ~/.claude, and use TMPDIR for scratch files. Never use dangerouslyDisableSandbox; if a sandboxed Bash command cannot start, report the sandbox failure instead.}"

server_sandbox_inherited="${SUBAGENT_SUPERVISOR_SERVER_SANDBOX_INHERITED:-${SUBAGENT_SUPERVISOR_INHERITED_SANDBOX:-}}"
if [[ -z "$server_sandbox_inherited" ]] &&
  ([[ "${CODEX_SANDBOX:-}" == "seatbelt" ]] || [[ "${CODEX_SHELL:-}" == "1" ]]); then
  server_sandbox_inherited=1
fi

if [[ "$server_sandbox_inherited" == "1" ]] ||
  [[ "${CODEX_SANDBOX:-}" == "seatbelt" ]] ||
  [[ "${CODEX_SHELL:-}" == "1" ]]; then
  export SUBAGENT_SUPERVISOR_INHERITED_SANDBOX=1
fi

add_dirs=()
settings_args=()

tmp_root="${TMPDIR:-/tmp}"
config_dir="${CLAUDE_SUBAGENT_CONFIG_DIR:-${tmp_root%/}/subagent-supervisor/claude-config}"
mkdir -p "$config_dir/session-env" "$config_dir/debug" "$config_dir/agents"
export CLAUDE_CONFIG_DIR="$config_dir"

normalize_dir() {
  local dir="$1"

  if [[ -d "$dir" ]]; then
    (cd "$dir" && pwd -P)
  else
    printf '%s' "$dir"
  fi
}

cwd_dir="$(normalize_dir "${SUBAGENT_SUPERVISOR_CWD:-$(pwd -P)}")"
write_roots_raw="${SUBAGENT_SUPERVISOR_SANDBOX_WRITE_ROOTS:-${SUBAGENT_SUPERVISOR_SANDBOX_WRITABLE_ROOTS:-}}"
write_bounded="${SUBAGENT_SUPERVISOR_SANDBOX_WRITE_BOUNDED:-}"
add_dirs+=(--add-dir "$cwd_dir")

json_string() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '"%s"' "$value"
}

path_is_within_roots() {
  local path="$1"
  local roots="$2"
  local root

  if [[ -z "$roots" && "$write_bounded" != "1" ]]; then
    return 0
  fi

  local IFS=':'
  for root in $roots; do
    [[ -n "$root" ]] || continue
    root="$(normalize_dir "$root")"

    if [[ "$path" == "$root" || "$path" == "$root"/* ]]; then
      return 0
    fi
  done

  return 1
}

cwd_writable="${SUBAGENT_SUPERVISOR_CWD_WRITABLE:-}"
if [[ -z "$cwd_writable" ]]; then
  if path_is_within_roots "$cwd_dir" "$write_roots_raw"; then
    cwd_writable=1
  else
    cwd_writable=0
  fi
fi

print_allow_write() {
  local sep=""

  printf '      "allowWrite": ['

  if [[ "$cwd_writable" == "1" ]]; then
    printf '%s%s' "$sep" "$(json_string "$cwd_dir")"
    sep=", "
  fi

  printf '%s%s' "$sep" "$(json_string "$tmp_root")"
  printf ', "/tmp", "/private/tmp"],\n'
}

runtime_settings="$config_dir/subagent-settings.json"
if [[ "$server_sandbox_inherited" == "1" && "$cwd_writable" == "1" ]]; then
  printf '{ "sandbox": { "enabled": false } }\n' > "$runtime_settings"
else
  {
    printf '{\n'
    printf '  "sandbox": {\n'
    printf '    "enabled": true,\n'
    printf '    "failIfUnavailable": true,\n'
    printf '    "autoAllowBashIfSandboxed": true,\n'
    printf '    "allowUnsandboxedCommands": false,\n'
    printf '    "filesystem": {\n'
    print_allow_write
    printf '      "denyWrite": [\n'
    printf '        "%s/.git/**",\n' "$cwd_dir"
    printf '        "%s/.claude/settings*.json",\n' "$cwd_dir"
    printf '        "%s/.claude/skills/**",\n' "$cwd_dir"
    printf '        "%s/.claude/hooks/**"\n' "$cwd_dir"
    printf '      ]\n'
    printf '    }\n'
    printf '  }\n'
    printf '}\n'
  } >"$runtime_settings"
fi
settings_args+=(--settings "$runtime_settings")

if [[ -n "${TMPDIR:-}" ]]; then
  add_dirs+=(--add-dir "$TMPDIR")
fi

if [[ -n "${HOME:-}" ]]; then
  if [[ -f "$HOME/.claude/settings.json" ]]; then
    cp "$HOME/.claude/settings.json" "$config_dir/settings.json"
  fi

  if [[ -d "$HOME/.claude/agents" ]]; then
    find "$HOME/.claude/agents" -maxdepth 1 -type f -name '*.md' -exec cp {} "$config_dir/agents/" \;
  fi
fi

agent_name=""
if [[ "${1:-}" == "--agent" ]]; then
  agent_name="$2"
  shift 2
fi

resume_session=""
if [[ "${1:-}" == "--resume" ]]; then
  resume_session="$2"
  shift 2
fi

agent_args=()
if [[ -n "$agent_name" ]]; then
  agent_args=(--agent "$agent_name")
fi

resume_args=()
if [[ -n "$resume_session" ]]; then
  resume_args=(--resume "$resume_session" --fork-session)
fi

user_prompt="$*"
prompt="${subagent_prompt}

User task:
${user_prompt}"

exec claude -p \
  --permission-mode "$permission_mode" \
  --append-system-prompt "$subagent_prompt" \
  "${add_dirs[@]}" \
  "${settings_args[@]}" \
  --disallowedTools \
    "Bash(rm:*) Bash(rm -rf:*) Bash(sudo:*) Bash(git push --force:*) Bash(git reset --hard:*)" \
  --max-budget-usd "$budget" \
  --output-format stream-json \
  --include-partial-messages \
  --verbose \
  --no-session-persistence \
  "${resume_args[@]}" \
  "${agent_args[@]}" \
  "$prompt"
