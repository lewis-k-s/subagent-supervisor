#!/usr/bin/env bash
set -euo pipefail

budget="${CLAUDE_SUBAGENT_BUDGET:-2.0}"
permission_mode="${CLAUDE_SUBAGENT_PERMISSION_MODE:-auto}"
subagent_prompt="${CLAUDE_SUBAGENT_SYSTEM_PROMPT:-Keep commands conservative: do not run destructive shell commands, do not modify ~/.claude, and use TMPDIR for scratch files.}"

if [[ "${SUBAGENT_SUPERVISOR_INHERITED_SANDBOX:-}" == "1" ]] ||
  [[ "${CODEX_SANDBOX:-}" == "seatbelt" ]] ||
  [[ "${CODEX_SHELL:-}" == "1" ]]; then
  export SUBAGENT_SUPERVISOR_INHERITED_SANDBOX=1

  inherited_sandbox_prompt="This subagent is already running inside an inherited parent sandbox. For Bash tool calls only, include dangerouslyDisableSandbox: true to avoid nested macOS sandbox-exec failure. This does not remove the inherited parent sandbox. Do not use that flag when SUBAGENT_SUPERVISOR_INHERITED_SANDBOX is not set."
  subagent_prompt="${inherited_sandbox_prompt} ${subagent_prompt}"
fi

add_dirs=()
settings_args=()

tmp_root="${TMPDIR:-/tmp}"
config_dir="${CLAUDE_SUBAGENT_CONFIG_DIR:-${tmp_root%/}/subagent-supervisor/claude-config}"
mkdir -p "$config_dir/session-env" "$config_dir/debug"
export CLAUDE_CONFIG_DIR="$config_dir"

if [[ -n "${TMPDIR:-}" ]]; then
  add_dirs+=(--add-dir "$TMPDIR")
fi

if [[ -n "${HOME:-}" ]]; then
  if [[ -f "$HOME/.claude/settings.json" ]]; then
    settings_args+=(--settings "$HOME/.claude/settings.json")
  fi

  add_dirs+=(--add-dir "$HOME/.claude/session-env" --add-dir "$HOME/.claude/debug")
fi

agent_name=""
if [[ "${1:-}" == "--agent" ]]; then
  agent_name="$2"
  shift 2
fi

agent_args=()
if [[ -n "$agent_name" ]]; then
  agent_args=(--agent "$agent_name")
fi

user_prompt="$*"
prompt="${subagent_prompt}

User task:
${user_prompt}"

exec claude -p \
  --permission-mode "$permission_mode" \
  --append-system-prompt "$subagent_prompt" \
  "${add_dirs[@]}" \
  "${settings_args[@]}" \
  --disallowedTools \
    "Bash(rm:*) Bash(rm -rf:*) Bash(sudo:*) Bash(git push --force:*) Bash(git reset --hard:*)" \
  --max-budget-usd "$budget" \
  --output-format stream-json \
  --include-partial-messages \
  --verbose \
  --no-session-persistence \
  "${agent_args[@]}" \
  "$prompt"
